;; Goku config for Karabiner-Elements
;; Edit this file — gokuw auto-compiles to karabiner.json
;;
;; Modifier shorthand:
;;   !  = mandatory   #  = optional
;;   C  = left_command    Q  = right_command
;;   T  = left_control    W  = right_control
;;   O  = left_option     E  = right_option
;;   S  = left_shift      R  = right_shift
;;   F  = fn              P  = caps_lock
;;   !! = hyper (cmd+ctrl+opt+shift)
;;   ## = optional any
;;
;; Sub-layer behavior:
;;   CleanShot (caps+c) = one-shot: action fires then exits mode
;;   Window (caps+w)    = hold: mode active while W held, release W to exit

{:profiles {:Default {:default true
                      :sim     50
                      :delay   500
                      :alone   500
                      :held    500}}

 :templates {:cleanshot "echo 'url cleanshot://%s' > /tmp/karabiner-hud.fifo ; echo 'hide' > /tmp/karabiner-hud.fifo"
             ;; NOTE: use the brew shim path — /usr/local/bin/aerospace is a
             ;; version-pinned Caskroom symlink that breaks on every upgrade
             :aero      "/opt/homebrew/bin/aerospace %s"
             :aero2     "/opt/homebrew/bin/aerospace %s %s"
             :tmux      "/opt/homebrew/bin/tmux %s"
             :kb        "echo '%s' > /tmp/karabiner-scripts.fifo &"
             :hud       "echo '%s' > /tmp/karabiner-hud.fifo &"
             :open      "echo 'url %s' > /tmp/karabiner-hud.fifo &"}

 :applications {;; Games: vim nav layer + Right-Cmd→Hyper are disabled while one of
                ;; these is frontmost (keyboard goes back to stock for gaming).
                ;; Add more game bundle IDs here as needed.
                :games     ["^com\\.grizzlygames\\.thronefall$"]
                :arc       ["^company\\.thebrowser\\.Browser$"]
                :raycast   ["^com\\.raycast\\.macos$"]
                :ghostty   ["^com\\.mitchellh\\.ghostty$"]
                :cmux      ["^com\\.cmuxterm\\.app$"
                            "^com\\.cmuxterm\\.app\\.smooth$"]
                ;; Prism's Minecraft JVM has no bundle id on this Mac, so match its executable path too.
                :minecraft [:identifiers "^org\\.prismlauncher\\.PrismLauncher$"
                            :paths "^/Users/linyanyu/Library/Application Support/PrismLauncher/java/.*/bin/java$"]}
 :input-sources {:zhuyin {:input_source_id "^com\\.apple\\.inputmethod\\.TCIM$"
                          :input_mode_id "^com\\.apple\\.inputmethod\\.TCIM\\.Zhuyin$"}}
 :layers {}
 :simlayers {}

 :main [;; ===== lan-mouse: hand keyboard+trackpad to omarchy (2026-09-03) =====
        ;; MUST be the first block. Variable `lanmouse` (0/1) is the single
        ;; source of truth, set by ~/.local/bin/lm-switch — never a profile switch.
        ;;
        ;; lanmouse=0 (normal Mac use): Right Cmd is already Hyper by the time
        ;; Backspace arrives (Karabiner matches per key-event, not per chord),
        ;; so the outbound trigger matches Hyper+Backspace.
        ;; lanmouse=1 (omarchy has the keyboard): the catch-all below keeps
        ;; Right Cmd physical, so the return trigger matches right_command.
        ;;
        ;; While lanmouse=1 everything else passes through RAW (omarchy's keyd
        ;; does the remapping there). Exceptions before the catch-all:
        ;;   Caps Lock → F19 on the wire (a real caps_lock would toggle macOS
        ;;     caps/input-source; keyd on omarchy maps f19 back to the caps layer).
        ;;     F19 is RESERVED for this — not a free Raycast phantom key anymore.
        ;;   F1-F12 → fn+F1..F12 so they leave as real F keys (fnState=0 would
        ;;     otherwise turn them into media keys after complex mods).
        {:des "lan-mouse - switch + raw pass-through while omarchy has input"
         :rules [[:!TOC##delete_or_backspace {:shell "/Users/linyanyu/.local/bin/lm-switch to-omarchy" :repeat false} [["lanmouse" 0]]]
                 [:!Q##delete_or_backspace   {:shell "/Users/linyanyu/.local/bin/lm-switch to-mac"     :repeat false} [["lanmouse" 1]]]
                 [:##caps_lock :f19 [["lanmouse" 1]]]
                 [:##f1  :!Ff1  [["lanmouse" 1]]]
                 [:##f2  :!Ff2  [["lanmouse" 1]]]
                 [:##f3  :!Ff3  [["lanmouse" 1]]]
                 [:##f4  :!Ff4  [["lanmouse" 1]]]
                 [:##f5  :!Ff5  [["lanmouse" 1]]]
                 [:##f6  :!Ff6  [["lanmouse" 1]]]
                 [:##f7  :!Ff7  [["lanmouse" 1]]]
                 [:##f8  :!Ff8  [["lanmouse" 1]]]
                 [:##f9  :!Ff9  [["lanmouse" 1]]]
                 [:##f10 :!Ff10 [["lanmouse" 1]]]
                 [:##f11 :!Ff11 [["lanmouse" 1]]]
                 [:##f12 :!Ff12 [["lanmouse" 1]]]
                 ;; raw Karabiner manipulator (goku passes {:type :basic} maps
                 ;; through untouched): from.any + to.from_event = pass-through
                 ;; that pre-empts every later complex modification.
                 {:type :basic
                  :from {:any "key_code" :modifiers {:optional ["any"]}}
                  :to [{:from_event true}]
                  :conditions [{:type "variable_if" :name "lanmouse" :value 1}]}]}

        ;; ===== Fix: Zhuyin eats Ctrl+number — re-send to bypass input method =====
        {:des "Zhuyin - pass through Ctrl+numbers"
         :rules [[:!T1 :!T1 [:zhuyin]] [:!T2 :!T2 [:zhuyin]] [:!T3 :!T3 [:zhuyin]]
                 [:!T4 :!T4 [:zhuyin]] [:!T5 :!T5 [:zhuyin]] [:!T6 :!T6 [:zhuyin]]
                 [:!T7 :!T7 [:zhuyin]] [:!T8 :!T8 [:zhuyin]] [:!T9 :!T9 [:zhuyin]]]}

        ;; ===== Caps Lock: master key =====
        ;; Minecraft gets an F20 marker for Caps' lifetime so MCBridge can gate direct input.
        ;; The second rule preserves the ordinary global Caps layer without leaking F20 to apps.
        {:des "Caps Lock - Minecraft master layer + F20 input gate"
         :rules [[:##caps_lock [["caps-mode" 1]
                               ["cleanshot-mode" 0]
                               ["window-mode" 0]
                               ["resize-mode" 0]
                               ["mcbridge-page2" 0]
                               ["mcbridge-page2-group-1" 0]
                               ;; Explicit repeat lets a refocused game reacquire a still-held gate.
                               {:key :f20 :repeat true}
                               [:hud "show caps"]]
                  [:minecraft]
                  {:afterup [["caps-mode" 0] [:hud "hide caps"]]
                   :alone :escape}]]}

        ;; Hold = caps-mode, tap alone = escape; reset all global sub-layers.
        {:des "Caps Lock - master layer + reset all modes"
         :rules [[:##caps_lock [["caps-mode" 1]
                               ["cleanshot-mode" 0]
                               ["window-mode" 0]
                               ["resize-mode" 0]
                               ["mcbridge-page2" 0]
                               ["mcbridge-page2-group-1" 0]
                               [:hud "show caps"]]
                  nil
                  {:afterup [["caps-mode" 0] [:hud "hide caps"]]
                   :alone :escape}]]}

        ;; ===== Sub-layer: CleanShot (caps + c) — one-shot =====
        ;; Hold caps, tap c, release caps, tap action key → fires & exits
        {:des "CleanShot mode"
         :rules [[:c [[:cleanshot "capture-area"]                ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:a [[:cleanshot "capture-area?action=annotate"] ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:v [[:cleanshot "capture-area?action=pin"]      ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:p [[:cleanshot "capture-previous-area"]        ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:f [[:cleanshot "capture-fullscreen"]           ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:w [[:cleanshot "capture-window"]               ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:s [[:cleanshot "scrolling-capture"]            ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:t [[:cleanshot "capture-text"]                 ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:r [[:cleanshot "record-screen"]                ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:h [[:cleanshot "open-history"]                 ["cleanshot-mode" 0]] [:cleanshot-mode ["caps-mode" 0]]]
                 [:escape [["cleanshot-mode" 0] [:hud "hide"]] [:cleanshot-mode]]]}

        ;; ===== Sub-layer: Window Management (caps + hold w) — hold =====
        ;; Hold caps, HOLD w, release caps, tap h/j/k/l repeatedly, release w to exit
        ;; Mode stays active as long as W is held
        {:des "Window mode"
         :rules [;; h/j/k/l = move focus (no mode reset — repeatable)
                 [:h [:aero "focus left"]                     [:window-mode]]
                 [:j [:aero "focus down"]                     [:window-mode]]
                 [:k [:aero "focus up"]                       [:window-mode]]
                 [:l [:aero "focus right"]                    [:window-mode]]
                 ;; shift + h/j/k/l = move window
                 [:!Sh [:aero "move left"]                    [:window-mode]]
                 [:!Sj [:aero "move down"]                    [:window-mode]]
                 [:!Sk [:aero "move up"]                      [:window-mode]]
                 [:!Sl [:aero "move right"]                   [:window-mode]]
                 ;; f = toggle fullscreen
                 [:f [:aero "fullscreen"]                     [:window-mode]]
                 ;; b = balance sizes
                 [:b [:aero "balance-sizes"]                  [:window-mode]]
                 ;; e = toggle layout
                 [:e [:aero "layout tiles horizontal vertical"] [:window-mode]]
                 ;; 1-9 = jump to workspace
                 [:1 [:aero "workspace 1"]                    [:window-mode]]
                 [:2 [:aero "workspace 2"]                    [:window-mode]]
                 [:3 [:aero "workspace 3"]                    [:window-mode]]
                 [:4 [:aero "workspace 4"]                    [:window-mode]]
                 [:5 [:aero "workspace 5"]                    [:window-mode]]
                 [:6 [:aero "workspace 6"]                    [:window-mode]]
                 [:7 [:aero "workspace 7"]                    [:window-mode]]
                 [:8 [:aero "workspace 8"]                    [:window-mode]]
                 [:9 [:aero "workspace 9"]                    [:window-mode]]
                 ;; shift + 1-9 = move window to workspace
                 [:!S1 [:aero "move-node-to-workspace 1"]     [:window-mode]]
                 [:!S2 [:aero "move-node-to-workspace 2"]     [:window-mode]]
                 [:!S3 [:aero "move-node-to-workspace 3"]     [:window-mode]]
                 [:!S4 [:aero "move-node-to-workspace 4"]     [:window-mode]]
                 [:!S5 [:aero "move-node-to-workspace 5"]     [:window-mode]]
                 [:!S6 [:aero "move-node-to-workspace 6"]     [:window-mode]]
                 [:!S7 [:aero "move-node-to-workspace 7"]     [:window-mode]]
                 [:!S8 [:aero "move-node-to-workspace 8"]     [:window-mode]]
                 [:!S9 [:aero "move-node-to-workspace 9"]     [:window-mode]]
                 ;; r = enter resize sub-mode
                 [:r [["resize-mode" 1] [:hud "show resize"]] [:window-mode]]]}

        ;; ===== Sub-sub-layer: Resize mode (window → r → ...) =====
        ;; Stays active for repeated resizes, escape or release W to exit
        {:des "Resize mode"
         :rules [[:h [:aero2 "resize" "width -50"]  [:resize-mode]]
                 [:j [:aero2 "resize" "height +50"] [:resize-mode]]
                 [:k [:aero2 "resize" "height -50"] [:resize-mode]]
                 [:l [:aero2 "resize" "width +50"]  [:resize-mode]]
                 [:escape [["resize-mode" 0] [:hud "show window"]] [:resize-mode]]]}


        ;; ===== Brightness keys =====
        ;; Handled by BetterDisplay's native brightness-key takeover
        ;; (videoMediaKeyAssumeControlMode=1 + allowKeyboardControl off for the
        ;; built-in display) — native feel, OSD, and only the external moves
        ;; while mirrored. Karabiner stays out of F1/F2. The old script route
        ;; (scripts/brightness-key.sh) is kept on disk as a fallback.

        ;; ===== Right Command → Hyper (Cmd+Ctrl+Opt) =====
        ;; ===== Raycast hotkeys via phantom-key indirection =====
        ;; Raycast's hotkeys are re-recorded onto F17/F18/... (keys no physical
        ;; keyboard sends). Karabiner turns ⌥S/⌥D into those phantom keys
        ;; everywhere EXCEPT games — so outside games the combo triggers
        ;; Raycast exactly as before, and inside games the game receives the
        ;; real ⌥S/⌥D while Raycast (still running) hears nothing.
        ;; To add another Raycast hotkey: pick the next free F-key (F21+ —
        ;; F19 is the lan-mouse Caps wire key, F20 the Minecraft caps gate),
        ;; add a row here, recompile,
        ;; then re-record the hotkey in Raycast by pressing the ⌥-combo.
        {:des "Raycast phantom hotkeys - ⌥S/⌥D → F17/F18 outside games"
         :rules [[:!Os :f17 [:!games]]
                 [:!Od :f18 [:!games]]]}

        ;; Disabled in games — Raycast hotkeys live on Hyper, so this also
        ;; stops Raycast from firing mid-game.
        {:des "Right Command → Hyper (Cmd+Ctrl+Opt)"
         :rules [[:##right_command :!TOleft_command [:!games]]]}

        ;; Caps distinguishes swap from the existing Right Command Hyper focus
        ;; bindings without changing Right Command's proven modifier mapping.
        {:des "Caps + Hyper + HJKL → AeroSpace swap"
         :rules [[:!TOCh [:aero "swap left"]  [:!games ["caps-mode" 1]]]
                 [:!TOCj [:aero "swap down"]  [:!games ["caps-mode" 1]]]
                 [:!TOCk [:aero "swap up"]    [:!games ["caps-mode" 1]]]
                 [:!TOCl [:aero "swap right"] [:!games ["caps-mode" 1]]]]}

        ;; ===== Vim navigation layer (migrated from BTT) =====
        ;; Left Option held = movement. Karabiner gives key-repeat + rollover
        ;; for free (both were broken in BTT).
        ;;   h/j/k/l = arrows   w/b = word fwd/back
        ;;   a = end of line    i = start of line
        ;;   g = top of doc     shift+g = bottom of doc (vim gg / G)
        ;; Disabled in games (:!games) — Option combos go straight to the game.
        {:des "Vim nav - Option + h/j/k/l/w/b/a/i/g"
         :rules [[:!Oh :left_arrow [:!games]]
                 [:!Oj :down_arrow [:!games]]
                 [:!Ok :up_arrow [:!games]]
                 [:!Ol :right_arrow [:!games]]
                 [:!Ow :!Oright_arrow [:!games]]
                 [:!Ob :!Oleft_arrow [:!games]]
                 [:!Oa :!Cright_arrow [:!games]]
                 [:!Oi :!Cleft_arrow [:!games]]
                 [:!Og :!Cup_arrow [:!games]]]}

        ;; Option+Shift = same movement but selecting (except g = bottom of doc)
        {:des "Vim select - Option+Shift + h/j/k/l/w/b/a/i, g = doc bottom"
         :rules [[:!OSh :!Sleft_arrow [:!games]]
                 [:!OSj :!Sdown_arrow [:!games]]
                 [:!OSk :!Sup_arrow [:!games]]
                 [:!OSl :!Sright_arrow [:!games]]
                 [:!OSw :!OSright_arrow [:!games]]
                 [:!OSb :!OSleft_arrow [:!games]]
                 [:!OSa :!CSright_arrow [:!games]]
                 [:!OSi :!CSleft_arrow [:!games]]
                 [:!OSg :!Cdown_arrow [:!games]]]}

        ;; ===== Per-app: Arc Browser =====
        {:des "Arc - caps+j/k spaces, caps+s sort tabs, cmd+\\ toggle pinned"
         :rules [[:j [:kb "arc-next-space"]  [:arc ["caps-mode" 1]]]
                 [:k [:kb "arc-prev-space"]  [:arc ["caps-mode" 1]]]
                 [:s [:kb "arc-sort-tabs"]   [:arc ["caps-mode" 1]]]
                 ;; Cmd+\ toggle: expand/collapse pinned tabs via daemon
                 [:!Cbackslash [:kb "arc-toggle-pinned"] [:arc]]]}

        ;; ===== Per-app: Ghostty + tmux =====
        {:des "Ghostty - caps+hjkl tmux panes, caps+f zoom, caps+v/s split, caps+x kill"
         :rules [;; h/j/k/l = switch tmux pane
                 [:h [:tmux "select-pane -L"] [:ghostty ["caps-mode" 1]]]
                 [:j [:tmux "select-pane -D"] [:ghostty ["caps-mode" 1]]]
                 [:k [:tmux "select-pane -U"] [:ghostty ["caps-mode" 1]]]
                 [:l [:tmux "select-pane -R"] [:ghostty ["caps-mode" 1]]]
                 ;; f = zoom toggle (tmux's "fullscreen" a pane)
                 [:f [:tmux "resize-pane -Z"] [:ghostty ["caps-mode" 1]]]
                 ;; v = vertical split (side by side), s = horizontal split (top/bottom)
                 [:v [:tmux "split-window -h -c '#{pane_current_path}'"] [:ghostty ["caps-mode" 1]]]
                 [:s [:tmux "split-window -v -c '#{pane_current_path}'"] [:ghostty ["caps-mode" 1]]]
                 ;; shift + h/j/k/l = swap pane in direction
                 [:!Sh [:tmux "swap-pane -t '{left}'"]  [:ghostty ["caps-mode" 1]]]
                 [:!Sj [:tmux "swap-pane -t '{down}'"]  [:ghostty ["caps-mode" 1]]]
                 [:!Sk [:tmux "swap-pane -t '{up}'"]    [:ghostty ["caps-mode" 1]]]
                 [:!Sl [:tmux "swap-pane -t '{right}'"] [:ghostty ["caps-mode" 1]]]
                 ;; x = kill pane
                 [:x [:tmux "kill-pane"] [:ghostty ["caps-mode" 1]]]]}

        ;; ===== Per-app: cmux =====
        {:des "cmux - caps+hjkl pane focus, caps+[/] workspace switch"
         :rules [;; Caps+HJKL = Focus Pane (sends Cmd+Opt+arrow)
                 [:h :!COleft_arrow  [:cmux ["caps-mode" 1]]]
                 [:j :!COdown_arrow  [:cmux ["caps-mode" 1]]]
                 [:k :!COup_arrow    [:cmux ["caps-mode" 1]]]
                 [:l :!COright_arrow [:cmux ["caps-mode" 1]]]
                 ;; f = toggle pane zoom (Cmd+Shift+Enter)
                 [:f :!CSreturn_or_enter [:cmux ["caps-mode" 1]]]
                 ;; [ / ] = prev/next workspace (Cmd+Ctrl+[/])
                 [:open_bracket  :!CTopen_bracket  [:cmux ["caps-mode" 1]]]
                 [:close_bracket :!CTclose_bracket [:cmux ["caps-mode" 1]]]]}

        ;; ===== Hyper key app-gated shortcuts =====
        ;; Raycast listens for these globally; we block them when not in the right app
        ;; so they only fire in context. Without these rules, the key passes through
        ;; and Raycast catches it.
        {:des "Hyper gates - block shortcuts outside target app"
         :rules [;; Hyper+A → Raycast Arc search: swallow when NOT in Arc
                 [:!CTOa :vk_none [:!arc :!raycast]]]}

        ;; ===== Hyper + O/U: instant macOS Space switch (migrated from BTT) =====
        ;; spacenav posts a synthetic max-velocity DockSwipe gesture (same private
        ;; mechanism BTT uses) — Dock commits the switch in ~1 frame, no animation.
        ;; Runs via the KarabinerScripts daemon (inherits its Accessibility).
        ;; Binary: ~/.local/bin/spacenav, source: ~/karabiner-config/spacenav/
        ;; :repeat false = fire once per physical press (like BTT did) — holding
        ;; won't machine-gun gestures, and every real tap lands with no throttle.
        ;; spacenav runs as a resident daemon (com.user.spacenav LaunchAgent,
        ;; log /tmp/spacenav.log) — echo straight into its FIFO, no process
        ;; spawn per keypress (~15ms keypress→switch, BTT-class latency).
        {:des "Hyper+O/U - space right/left without animation (spacenav daemon)"
         :rules [[:!CTOo {:shell "echo 'next' > /tmp/spacenav.fifo &" :repeat false}]
                 [:!CTOu {:shell "echo 'prev' > /tmp/spacenav.fifo &" :repeat false}]]}

        ;; ===== Minecraft Caps-only bridge actions =====
        ;; Everything else below the F leader moved into MCBridge 0.7's render-thread modal.
        {:des "Minecraft Caps+H self-damage (bridge-owned)"
         :rules [[:h {:shell "/bin/bash -c 'for i in 1 2; do printf \"W damage 7\" >/dev/udp/127.0.0.1/25581; sleep 0.1; done'"}
                  [:minecraft ["mc_ctx_gameplay" 1] ["caps-mode" 1]]]]}

        ;; ===== Minecraft: swallow lethal Cmd shortcuts during gameplay =====
        ;; Trackpad mode holds Left Cmd as key.use (eat/shield); Tab/Q are hotbar keys.
        ;; Without this, Cmd+Q quits the game and Cmd+Tab yanks focus mid-fight.
        ;; Gated on gameplay ctx so Cmd+Tab still app-switches from inventory/ESC menus.
        {:des "Minecraft - swallow Cmd+Q / Cmd+Tab in gameplay"
         :rules [[:!Cq :vk_none [:minecraft ["mc_ctx_gameplay" 1]]]
                 [:!Ctab :vk_none [:minecraft ["mc_ctx_gameplay" 1]]]]}

        ;; ===== MCBridge Caps+Period overflow — still bridge-owned =====
        ;; Ordinary gameplay, screen actions, F/Wurst, Timer, and mouse buttons are in-process.
        {:des "MCBridge page 2 leader (gameplay Caps+period)"
         :rules [[:period ["mcbridge-page2" 1] [:minecraft ["mc_ctx_gameplay" 1] ["caps-mode" 1]]]]}

        {:des "MCBridge gameplay page 2 actions"
         :rules [
          [:a [{:shell "/bin/bash -c 'printf \"H key.sprint\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]] {:afterup {:shell "/bin/bash -c 'printf \"R key.sprint\" >/dev/udp/127.0.0.1/25581'"}}]
          [:b [{:shell "/bin/bash -c 'printf \"T key.chat\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]]]
          [:c [{:shell "/bin/bash -c 'printf \"T key.socialInteractions\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]]]
          [:d [{:shell "/bin/bash -c 'printf \"T key.smoothCamera\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]]]
          [:e [{:shell "/bin/bash -c 'printf \"T key.spectatorOutlines\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]]]
          [:f [{:shell "/bin/bash -c 'printf \"T key.saveToolbarActivator\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]]]
          [:g [{:shell "/bin/bash -c 'printf \"T key.loadToolbarActivator\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]]]
          [:h [{:shell "/bin/bash -c 'printf \"H key.valkyrienskies.ship_down\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]] {:afterup {:shell "/bin/bash -c 'printf \"R key.valkyrienskies.ship_down\" >/dev/udp/127.0.0.1/25581'"}}]
          [:i [{:shell "/bin/bash -c 'printf \"T key.valkyrienskies.ship_cruise\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]]]
          [:j [{:shell "/bin/bash -c 'printf \"H key.adventurez.dragonflydown\" >/dev/udp/127.0.0.1/25581'"} ["mcbridge-page2" 0]] [:minecraft ["mc_ctx_gameplay" 1] ["mcbridge-page2" 1] ["caps-mode" 0]] {:afterup {:shell "/bin/bash -c 'printf \"R key.adventurez.dragonflydown\" >/dev/udp/127.0.0.1/25581'"}}]
