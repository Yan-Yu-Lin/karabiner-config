+@testable import AppBundle
+import XCTest
+
+@MainActor
+final class FocusCacheTest: XCTestCase {
+    override func setUp() async throws {
+        setUpWorkspacesForTests()
+    }
+
+    func testRejectsCrossWorkspaceEchoFromSameAppAndReassertsOnlyOnce() {
+        let target = NativeFocusObservation(windowId: 10, appPid: 1, workspaceName: "10")
+        let wrong = NativeFocusObservation(windowId: 3, appPid: 1, workspaceName: "3")
+        var guardState = NativeFocusEchoGuard(target: target, deadline: 1)
+
+        assertEquals(guardState.consume(native: target, model: target, now: 0, isUserMouseFocus: false), .acceptAndKeep)
+        assertEquals(guardState.consume(native: wrong, model: target, now: 0, isUserMouseFocus: false), .rejectAndReassert)
+        assertEquals(guardState.consume(native: wrong, model: target, now: 0, isUserMouseFocus: false), .reject)
+        assertEquals(guardState.consume(native: target, model: target, now: 0, isUserMouseFocus: false), .acceptAndClear)
+    }
+
+    func testDoesNotRejectSameWorkspaceWindow() {
+        let target = NativeFocusObservation(windowId: 10, appPid: 1, workspaceName: "10")
+        let sibling = NativeFocusObservation(windowId: 11, appPid: 1, workspaceName: "10")
+        var guardState = NativeFocusEchoGuard(target: target, deadline: 1)
+
+        assertEquals(guardState.consume(native: sibling, model: target, now: 0, isUserMouseFocus: false), .acceptAndClear)
+    }
+
+    func testDoesNotRejectDifferentApp() {
+        let target = NativeFocusObservation(windowId: 10, appPid: 1, workspaceName: "10")
+        let otherApp = NativeFocusObservation(windowId: 3, appPid: 2, workspaceName: "3")
+        var guardState = NativeFocusEchoGuard(target: target, deadline: 1)
+
+        assertEquals(guardState.consume(native: otherApp, model: target, now: 0, isUserMouseFocus: false), .acceptAndClear)
+    }
+
+    func testDoesNotRejectUserMouseFocusOrExpiredEcho() {
+        let target = NativeFocusObservation(windowId: 10, appPid: 1, workspaceName: "10")
+        let wrong = NativeFocusObservation(windowId: 3, appPid: 1, workspaceName: "3")
+        var mouseGuard = NativeFocusEchoGuard(target: target, deadline: 1)
+        var expiredGuard = NativeFocusEchoGuard(target: target, deadline: 1)
+
+        assertEquals(mouseGuard.consume(native: wrong, model: target, now: 0, isUserMouseFocus: true), .acceptAndClear)
+        assertEquals(expiredGuard.consume(native: wrong, model: target, now: 1, isUserMouseFocus: false), .acceptAndClear)
+    }
+
+    func testUpdateFocusCacheKeepsIntentionalWorkspaceAndReassertsTarget() {
+        let wrongWorkspace = Workspace.get(byName: "3")
+        let targetWorkspace = Workspace.get(byName: "10")
+        let wrong = TestWindow.new(id: 3, parent: wrongWorkspace.rootTilingContainer)
+        let target = TestWindow.new(id: 10, parent: targetWorkspace.rootTilingContainer)
+        assertTrue(target.focusWindow())
+        beginNativeFocusEchoGuard(for: target)
+
+        updateFocusCache(wrong)
+
+        assertEquals(focus.windowOrNil?.windowId, target.windowId)
+        assertEquals(focus.workspace.name, targetWorkspace.name)
+        assertEquals(TestApp.shared.focusedWindow?.windowId, target.windowId)
+    }
+}
