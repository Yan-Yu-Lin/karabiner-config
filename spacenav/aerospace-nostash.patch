+func hiddenCornerReparkTarget(
+    windowRect: Rect,
+    corner: OptimalHideCorner,
+    monitorVisibleRect: Rect,
+    isZoom: Bool,
+) -> CGPoint? {
+    let target: CGPoint = switch corner {
+        case .bottomLeftCorner:
+            // Zoom will jump off if you do one pixel offset https://github.com/nikitabobko/AeroSpace/issues/527
+            // todo this ad hoc won't be necessary once I implement optimization suggested by Zalim
+            monitorVisibleRect.bottomLeftCorner + (isZoom ? .zero : CGPoint(x: 1, y: -1)) + CGPoint(x: -windowRect.width, y: 0)
+        case .bottomRightCorner:
+            // Zoom will jump off if you do one pixel offset https://github.com/nikitabobko/AeroSpace/issues/527
+            // todo this ad hoc won't be necessary once I implement optimization suggested by Zalim
+            monitorVisibleRect.bottomRightCorner - (isZoom ? .zero : CGPoint(x: 1, y: 1))
+    }
+    return windowRect.topLeftCorner == target ? nil : target
