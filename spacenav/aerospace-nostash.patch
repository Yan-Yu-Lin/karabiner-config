+@testable import AppBundle
+import XCTest
+
+final class CornerStashTest: XCTestCase {
+    private let monitor = Rect(topLeftX: 0, topLeftY: 0, width: 1920, height: 1080)
+
+    func testDetectsBottomRightFrameDrift() {
+        let drifted = Rect(topLeftX: 700, topLeftY: 300, width: 500, height: 400)
+
+        XCTAssertEqual(
+            hiddenCornerReparkTarget(
+                windowRect: drifted,
+                corner: .bottomRightCorner,
+                monitorVisibleRect: monitor,
+                isZoom: false,
+            ),
+            CGPoint(x: 1919, y: 1079),
+        )
+    }
+
+    func testAlreadyParkedWindowNeedsNoFrameWrite() {
+        let parked = Rect(topLeftX: 1919, topLeftY: 1079, width: 500, height: 400)
+
+        XCTAssertNil(hiddenCornerReparkTarget(
+            windowRect: parked,
+            corner: .bottomRightCorner,
+            monitorVisibleRect: monitor,
+            isZoom: false,
+        ))
+    }
+
+    func testBottomLeftTargetAccountsForWindowWidth() {
+        let drifted = Rect(topLeftX: 700, topLeftY: 300, width: 500, height: 400)
+
+        XCTAssertEqual(
+            hiddenCornerReparkTarget(
+                windowRect: drifted,
+                corner: .bottomLeftCorner,
+                monitorVisibleRect: monitor,
+                isZoom: false,
+            ),
+            CGPoint(x: -499, y: 1079),
+        )
+    }
+
+    func testZoomKeepsZeroPixelOffset() {
+        let drifted = Rect(topLeftX: 700, topLeftY: 300, width: 500, height: 400)
+
+        XCTAssertEqual(
+            hiddenCornerReparkTarget(
+                windowRect: drifted,
+                corner: .bottomRightCorner,
+                monitorVisibleRect: monitor,
+                isZoom: true,
+            ),
+            CGPoint(x: 1920, y: 1080),
+        )
+    }
+}
