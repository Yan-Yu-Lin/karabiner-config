+private let nativeSpaceHideSuppressionDuration: TimeInterval = 1
+@MainActor private var nativeSpaceHideSuppressionDeadline: TimeInterval = 0
+
+@MainActor
+func beginNativeSpaceHideSuppression() {
+    nativeSpaceHideSuppressionDeadline = ProcessInfo.processInfo.systemUptime + nativeSpaceHideSuppressionDuration
+}
+
+@MainActor
+private var shouldSuppressNativeSpaceHide: Bool {
+    guard ProcessInfo.processInfo.systemUptime < nativeSpaceHideSuppressionDeadline else { return false }
+    guard let event = refreshSessionEvent else { return false }
+    return switch event {
+        case .ax, .globalObserver: true
+        default: false
+    }
+}
