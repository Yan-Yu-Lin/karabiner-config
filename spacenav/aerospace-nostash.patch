+import Common
+import Foundation
+
 @MainActor private var lastKnownNativeFocusedWindowId: UInt32? = nil
 
+private let nativeFocusEchoGuardDuration: TimeInterval = 0.5
+
+struct NativeFocusObservation: Equatable {
+    let windowId: UInt32
+    let appPid: Int32
+    let workspaceName: String
+}
+
+enum NativeFocusEchoAction: Equatable {
+    case acceptAndClear
+    case acceptAndKeep
+    case reject
+    case rejectAndReassert
+}
+
+struct NativeFocusEchoGuard {
+    let target: NativeFocusObservation
+    let deadline: TimeInterval
+    private(set) var hasRejectedMismatch = false
+
+    mutating func consume(
+        native: NativeFocusObservation?,
+        model: NativeFocusObservation?,
+        now: TimeInterval,
+        isUserMouseFocus: Bool,
+    ) -> NativeFocusEchoAction {
+        guard now < deadline, model == target, !isUserMouseFocus else { return .acceptAndClear }
+        guard let native else { return .acceptAndClear }
+        if native == target {
+            // Keep watching after the first confirmation: an app can select a different window slightly later.
+            return hasRejectedMismatch ? .acceptAndClear : .acceptAndKeep
+        }
+        guard native.appPid == target.appPid,
+              native.workspaceName != target.workspaceName
+        else { return .acceptAndClear }
+        if hasRejectedMismatch {
+            return .reject
+        } else {
+            hasRejectedMismatch = true
+            return .rejectAndReassert
+        }
+    }
+}
+
+@MainActor private var nativeFocusEchoGuard: NativeFocusEchoGuard? = nil
+
+@MainActor
+func beginNativeFocusEchoGuard(for target: Window) {
+    guard let target = nativeFocusObservation(target) else {
+        nativeFocusEchoGuard = nil
+        return
+    }
+    nativeFocusEchoGuard = NativeFocusEchoGuard(
+        target: target,
+        deadline: ProcessInfo.processInfo.systemUptime + nativeFocusEchoGuardDuration,
+    )
+}
+
+@MainActor
+func clearNativeFocusEchoGuard() {
+    nativeFocusEchoGuard = nil
+}
+
+@MainActor
+private func nativeFocusObservation(_ window: Window?) -> NativeFocusObservation? {
+    guard let window, let workspace = window.visualWorkspace else { return nil }
+    return NativeFocusObservation(windowId: window.windowId, appPid: window.app.pid, workspaceName: workspace.name)
+}
+
+@MainActor
+private var isUserMouseFocusEvent: Bool {
+    // Mouse focus is independently initiated by the user, so it must never be mistaken for our native-focus echo.
+    if isLeftMouseButtonDown { return true }
+    return switch refreshSessionEvent {
+        case .focusFollowsMouse, .globalObserverLeftMouseUp: true
+        default: false
+    }
+}
